+#[tokio::test]
+async fn explicit_loopback_no_auth_serves_models_and_speech_without_a_token() {
+    use clap::Parser;
+    use omnivoice_server::ServerArgs;
+
+    let args = ServerArgs::try_parse_from(["omnivoice-server", "--no-auth", "--host", "127.0.0.1"])
+        .unwrap();
+    let (app, runtime) = app_with_config(ServerConfig::from_args(&args).unwrap());
+    let models = app
+        .clone()
+        .oneshot(
+            Request::builder()
+                .uri("/v1/models")
+                .body(Body::empty())
+                .unwrap(),
+        )
+        .await
+        .unwrap();
+    assert_eq!(models.status(), StatusCode::OK);
+    let speech = app.oneshot(Request::builder()
+        .method("POST").uri("/v1/audio/speech")
+        .header(header::CONTENT_TYPE, "application/json")
+        .body(Body::from(json!({
+            "model": MODEL_ID, "input": "Hello", "voice": "alloy", "response_format": "wav"
+        }).to_string())).unwrap()).await.unwrap();
+    assert_eq!(speech.status(), StatusCode::OK);
+    assert_eq!(runtime.requests().len(), 1);
+}
